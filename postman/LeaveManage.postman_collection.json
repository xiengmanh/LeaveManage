                "type": "text/javascript",
                "exec": [
                  "// Ngày làm việc cách hôm nay 29 ngày (đủ báo trước 3 ngày của phép năm)",
                  "const d = new Date(); d.setDate(d.getDate() + 29);",
                  "while (d.getDay() === 0 || d.getDay() === 6) d.setDate(d.getDate() + 1);",
                  "pm.collectionVariables.set('leaveDay', d.toISOString().slice(0, 10));"
                ]
