{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "LeaveManage.Api",
    "Audience": "LeaveManage.Clients",
    "ExpiresInMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7103" ]
  },
  "Seed": {
    "Enabled": false
  },
  "RateLimit": {
    "AuthPerMinute": 20
  },
  "FileUpload": {
    "MaxImageSize": 3145728,
    "UploadFolder": "images",
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png" ],
    "AllowedContentTypes": [ "image/jpeg", "image/png" ]
  }
}
